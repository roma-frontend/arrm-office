+    } catch {
+      tokenRef.current = null;
+      setIsAuthenticated(false);
+      return null;
+    }
+  }, []);
+
+  useEffect(() => {
+    fetchAccessToken({ forceRefreshToken: true });
+  }, [fetchAccessToken]);
+
+  return useMemo(() => ({
+    isLoading,
+    isAuthenticated,
+    fetchAccessToken,
+  }), [isLoading, isAuthenticated, fetchAccessToken]);
