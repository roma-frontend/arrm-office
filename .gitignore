build-errors.txt
build-errors.log

# Scripts directory — ignore one-off / local debug scripts.
# Tracked tooling is explicitly allowlisted below.
# (Use scripts/* not scripts/ so negation patterns can take effect.)
scripts/*
!scripts/check-locale-parity.mjs
# Reports t() keys that resolve to an object or are missing everywhere.
!scripts/check-i18n-keys.mjs
# Coverage tooling invoked by .github/workflows/ci.yml — must be committed.
!scripts/compare-coverage.mjs
!scripts/generate-coverage-badge.mjs
!scripts/ratchet-coverage.mjs
# Security tooling: lists public Convex functions with no authorization check.
!scripts/audit-convex-auth.mjs
# Generates convex/lib/localeCatalog.ts from public/locales — npm run
# build:convex-locales, and `-- --check` in CI to catch a stale catalog.
!scripts/build-convex-locales.mjs
.vercel
.env*.local

