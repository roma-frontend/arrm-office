{
  "$schema": "https://unpkg.com/bundlewatch@0.4.0/schema.json",
  "files": [
    { "path": ".next/static/chunks/framework-*.js", "maxSize": "120KB" },
    { "path": ".next/static/chunks/commons-*.js", "maxSize": "80KB" },
    { "path": ".next/static/chunks/pages/_app-*.js", "maxSize": "200KB" },
    { "path": ".next/static/chunks/main-*.js", "maxSize": "200KB" },
    { "path": ".next/static/chunks/pages/index-*.js", "maxSize": "150KB" },
    {
      "path": ".next/static/chunks/app/(dashboard)/dashboard/*.js",
      "maxSize": "200KB"
    },
    {
      "path": ".next/static/chunks/app/(dashboard)/leaves/*.js",
      "maxSize": "200KB"
    },
    {
      "path": ".next/static/chunks/app/(dashboard)/tasks/*.js",
      "maxSize": "200KB"
    },
    {
      "path": ".next/static/chunks/app/(dashboard)/employees/*.js",
      "maxSize": "250KB"
    },
    {
      "path": ".next/static/chunks/app/(dashboard)/calendar/*.js",
      "maxSize": "300KB"
    },
    {
      "path": ".next/static/chunks/app/(dashboard)/chat/*.js",
      "maxSize": "300KB"
    },
    { "path": ".next/static/css/*.css", "maxSize": "60KB" }
  ],
  "ci": { "trackBranches": ["main"] }
}
